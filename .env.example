# Copiar a .env.local y completar con los datos de la rama `develop` de Neon (Connect → neondb / neondb_owner).
# .env.local no se commitea.

# Connection string CON pooling (host con "-pooler"). Lo usa la app.
DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Connection string SIN pooling (host sin "-pooler"). Lo usan los scripts de evolución y drizzle-kit.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Opcional: base VACÍA para verificar `npm run db:rebuild -- --confirm` (rama nueva de Neon o Postgres local con PostGIS).
# DATABASE_URL_REBUILD=

# Opcional: tests de integración (`npm test`). Sin estas variables, esos tests se saltean.
# TEST_DATABASE_URL: cualquier Postgres con PostGIS (tests de tipos geográficos).
# TEST_DATABASE_URL=
# TEST_NEON_DATABASE_URL: connection string pooled de una rama de Neon (tests de servicios:
# el driver de la app usa WebSocket). Crean y borran sus propios datos.
# TEST_NEON_DATABASE_URL=

# Neon Auth: BASE_URL = consola de Neon → Settings → Auth → "Auth URL" de la rama.
# COOKIE_SECRET: generar con `openssl rand -base64 32` (no sale de la consola).
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=

# Google Maps Platform: clave de navegador restringida por dominio (HTTP referrer) y por API
# (Maps JavaScript API + Places API (New)).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
